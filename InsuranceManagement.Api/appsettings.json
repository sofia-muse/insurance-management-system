{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=InsuranceManagement;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "RunMigrationsOnStartup": false,
    "RunSeedOnStartup": false
  },
  "ApiSecurity": {
    "EnableLegacyWriteApiKey": false,
    "WriteApiKey": ""
  },
  "Jwt": {
    "Issuer": "InsuranceManagement.Api",
    "Audience": "InsuranceManagement.Clients",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
