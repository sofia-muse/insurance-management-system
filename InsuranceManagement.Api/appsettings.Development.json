{
  "Database": {
    "RunMigrationsOnStartup": true,
    "RunSeedOnStartup": true
  },
  "ApiSecurity": {
    "EnableLegacyWriteApiKey": false,
    "WriteApiKey": ""
  },
  "Jwt": {
    "Issuer": "InsuranceManagement.Api.Dev",
    "Audience": "InsuranceManagement.Clients.Dev",
    "SigningKey": "dev-only-signing-key-change-before-production"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
